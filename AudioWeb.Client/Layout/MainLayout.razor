@inherits LayoutComponentBase


<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudDrawer @bind-Open="@_open" Anchor="Anchor.Left" Elevation="2" Variant="@DrawerVariant.Mini" OpenMiniOnHover="false">
        <NavMenuLeft OnMessageFromChild="DrawerToggle" />
    </MudDrawer>  
    <MudDrawer Anchor="Anchor.Right" Elevation="2" Variant="@DrawerVariant.Mini" OpenMiniOnHover="false">
        <NavMenuRight/>
    </MudDrawer>      
    <MudMainContent Class="pt-2 pa-2">
        @Body
    </MudMainContent>
</MudLayout>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _open = false;

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    private void DrawerToggle()
    {
        _open = !_open;
    } 


}


